# Server-side environment for the Antara Task AI backend.
# Copy to /home/deploy/antaratask/backend/.env, fill in the secrets, chmod 600.
GTM_HOST=127.0.0.1
GTM_PORT=8765
GTM_PUBLIC_ORIGIN=https://antaratask.dream-team.works
GTM_TIMEZONE=Asia/Jakarta
GTM_SECRET_KEY=replace-with-a-long-random-secret
GTM_GOOGLE_CLIENT_ID=replace-with-the-google-oauth-web-client-id
GTM_GOOGLE_ANDROID_CLIENT_ID=
GTM_SESSION_MAX_AGE_SECONDS=2592000

GTM_AI_ENABLED=true
GTM_AI_BASE_URL=https://gateway.dream-team.works/v1/chat/stream
GTM_AI_API_KEY=replace-with-the-app-client-plaintext-key
GTM_AI_MODEL=deepseek-v4.1-flash
GTM_AI_CAPABILITY=chat.standard
GTM_AI_MAX_OUTPUT_TOKENS=1024
GTM_AI_TIMEOUT_SECONDS=120

GTM_VOICE_ENABLED=true
