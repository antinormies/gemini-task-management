# GTM backend configuration. Copy to .env and fill in.
GTM_HOST=127.0.0.1
GTM_PORT=8765
GTM_TIMEZONE=Asia/Jakarta
GTM_PUBLIC_ORIGIN=http://127.0.0.1:8765
GTM_SECRET_KEY=replace-with-openssl-or-python-secret
GTM_AI_ENABLED=true
GTM_AI_PROVIDER=auto
GTM_VOICE_ENABLED=true
GTM_VOICE_PROVIDER=auto
GTM_AGY_BIN=agy
GTM_AGY_MODEL=gemini-3.8-flash-low
GTM_OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
GTM_OPENCODE_MODEL=deepseek-v4.1-flash
GTM_OPENCODE_API_KEY=
GTM_GEMINI_API_KEY=
