# GTM backend configuration. Copy to .env and fill in.
GTM_HOST=127.0.0.1
GTM_PORT=8765
GTM_TIMEZONE=Asia/Jakarta
GTM_PUBLIC_ORIGIN=http://127.0.0.1:8765
GTM_SECRET_KEY=replace-with-openssl-or-python-secret

# AI: single self provider (MemeChat Gateway, server-to-server).
GTM_AI_ENABLED=true
GTM_AI_BASE_URL=https://gateway.dream-team.works/internal/ai/complete
GTM_AI_API_KEY=replace-with-the-gateway-self-ai-key
GTM_AI_MODEL=deepseek-v4.1-flash
GTM_AI_TIMEOUT_SECONDS=120

GTM_VOICE_ENABLED=true
