# GTM backend configuration. Copy to .env and fill in.
GTM_HOST=127.0.0.1
GTM_PORT=8765
GTM_TIMEZONE=Asia/Jakarta
GTM_PUBLIC_ORIGIN=http://127.0.0.1:8765
GTM_SECRET_KEY=replace-with-openssl-or-python-secret
# Optional: lets the production Android app provision through the public host.
# Leave empty to keep auto-pair loopback-only.
GTM_AUTO_PAIR_KEY=

# AI: MemeChat Gateway app-client chat stream (X-App-Client-Key).
GTM_AI_ENABLED=true
GTM_AI_BASE_URL=https://gateway.dream-team.works/v1/chat/stream
GTM_AI_API_KEY=replace-with-the-app-client-key
GTM_AI_MODEL=deepseek-v4.1-flash
GTM_AI_CAPABILITY=chat.standard
GTM_AI_MAX_OUTPUT_TOKENS=1024
GTM_AI_TIMEOUT_SECONDS=120

GTM_VOICE_ENABLED=true
